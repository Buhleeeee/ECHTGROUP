@model List<ECHTGROUP.Models.InboxItemViewModel>
@{
    ViewData["Title"] = "Inbox";
}

<section class="band">
    <div class="wrap">
        <h1>Inbox</h1>
        <p class="lead">Conversations with clients.</p>
        <p><a class="btn-echt g" asp-action="Enquiries">Enquiries and contact messages</a></p>

        @if (Model.Count == 0)
        {
            <p>No messages yet.</p>
        }

        @foreach (var i in Model)
        {
            <a class="inrow" asp-action="Thread" asp-route-id="@i.ClientId">
                <div>
                    <div class="who">@i.ClientName</div>
                    <div class="prev">@i.LastMessage</div>
                </div>
                <div class="bright">
                    <span class="stamp">@i.LastAt.ToLocalTime().ToString("d MMM HH:mm")</span>
                    @if (i.Unread > 0)
                    {
                        <span class="unread">@i.Unread new</span>
                    }
                </div>
            </a>
        }
    </div>
</section>