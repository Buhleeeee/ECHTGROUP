@{
    ViewData["Title"] = "FAQ";
}

<section class="band">
    <div class="wrap faq">
        <h1>Frequently asked questions</h1>
        <details>
            <summary>How do I book a consultation?</summary>
            <p>Create an account, choose a service, then pick a date and time.</p>
        </details>
        <details>
            <summary>Do I have to pay to book?</summary>
            <p>No. Online payments are not part of this version of the site.</p>
        </details>
        <details>
            <summary>Who can see my details?</summary>
            <p>Only you and your assigned consultant. See our <a asp-controller="Home" asp-action="Privacy">privacy policy</a>.</p>
        </details>
        <details>
            <summary>Can I message my consultant?</summary>
            <p>Yes, from the Messages tab in your dashboard once you are signed in.</p>
        </details>
    </div>
</section>

