@{
    ViewData["Title"] = "Privacy policy";
}

<section class="band">
    <div class="wrap article">
        <h1>Privacy policy</h1>
        <p><em>Draft. Have this reviewed against the data-protection law that applies to the business before launch.</em></p>
        <h3>What we collect</h3>
        <p>Your name, title, email address, contact numbers, address and an optional gender and profile photo, along with your enquiry details, bookings and messages, and the time you agreed to this policy.</p>
        <h3>Why we collect it</h3>
        <p>To reply to your enquiries, manage your bookings and give you access to your account.</p>
        <h3>How long we keep it</h3>
        <p>To be confirmed.</p>
        <h3>Your rights</h3>
        <p>You can ask to see, correct or delete your information. Contact us using the details on the Contact page.</p>
    </div>
</section>