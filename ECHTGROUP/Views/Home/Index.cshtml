@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="wrap hg">
        <div>
            <h1>Where strategy meets opportunity.</h1>
            <p class="lead">Marketing, market development, legal and compliance, and IT, planned together so every decision rests on one clear plan.</p>
            <div class="acts">
                <a class="btn-echt" href="#">Book a consultation</a>
                <a class="btn-echt g" asp-controller="Services" asp-action="Index">See our services</a>
            </div>
        </div>
        <div class="panel rot">
            <div class="slide on"><b>4</b>consulting disciplines</div>
            <div class="slide"><b>1</b>team and one plan</div>
            <div class="slide"><b>2022</b>advising growing businesses</div>
            <div class="dots"><i></i><i></i><i></i></div>
        </div>
    </div>
</section>
<section class="band">
    <div class="wrap">
        <h2 class="rv">Four disciplines, one team</h2>
        <p class="lead rv">Most growth problems cross departments. We cover the four areas where they usually start.</p>
        <div class="svc-grid">
            <a class="scard rv" asp-controller="Services" asp-action="Details" asp-route-id="marketing">
                <div class="sn">01</div>
                <h3>Marketing</h3>
                <p>Positioning and campaigns that reach the right buyers and can be measured.</p>
            </a>
            <a class="scard rv" asp-controller="Services" asp-action="Details" asp-route-id="market-development">
                <div class="sn">02</div>
                <h3>Strategic Market Development</h3>
                <p>Evidence-based plans for entering new markets and growing the ones you are in.</p>
            </a>
            <a class="scard rv" asp-controller="Services" asp-action="Details" asp-route-id="legal-compliance">
                <div class="sn">03</div>
                <h3>Legal and Compliance</h3>
                <p>Practical guidance that keeps your business protected as it grows.</p>
            </a>
            <a class="scard rv" asp-controller="Services" asp-action="Details" asp-route-id="it">
                <div class="sn">04</div>
                <h3>IT</h3>
                <p>Technology choices that fit your goals, budget and security needs.</p>
            </a>
        </div>
    </div>
</section>
<section class="band alt">
    <div class="wrap">
        <h2 class="rv">How we work</h2>
        <div class="steps">
            <div class="rv">
                <div class="sn">1</div>
                <h3>Listen</h3>
                <p>We learn your business and goals before we recommend anything.</p>
            </div>
            <div class="rv">
                <div class="sn">2</div>
                <h3>Plan</h3>
                <p>A clear roadmap with priorities, owners, timelines and costs.</p>
            </div>
            <div class="rv">
                <div class="sn">3</div>
                <h3>Deliver</h3>
                <p>We work alongside your team and track results.</p>
            </div>
        </div>
    </div>
</section>

<section class="band">
    <div class="wrap">
        <h2 class="rv">What clients say</h2>
        <div class="panel rot">
            <div class="slide"><p class="quote">“One team and one plan saved us months of back and forth.” – Sample client</p></div>
            <div class="slide"><p class="quote">“The roadmap made our priorities clear from week one.” – Sample client</p></div>
            <div class="slide"><p class="quote">“Finally, advice that covers marketing, legal and IT together.” – Sample client</p></div>
            <div class="dots"><i></i><i></i><i></i></div>
        </div>
    </div>
</section>

<section class="dark-band">
    <div class="wrap dcols">
        <div class="rv">
            <h2>Advice that joins the dots</h2>
            <p>A marketing plan needs a legal check. A new market needs the right systems behind it. One point of contact, advice that fits together.</p>
            <a class="btn-echt" href="#">About us</a>
        </div>
        <ul class="facts rv">
            <li><b>4</b>disciplines</li>
            <li><b>1</b>team, one plan</li>
            <li><b>2022</b>advising growing businesses</li>
        </ul>
    </div>
</section>