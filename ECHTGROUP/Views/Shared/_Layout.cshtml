<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - ECHT GROUP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="wrap">
            <nav class="nav" aria-label="Main">
                <div class="hl">
                    <button class="burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu">
                        <i></i><i></i><i></i>
                    </button>
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <span class="mark" aria-hidden="true">eg.</span>ECHT GROUP
                    </a>
                </div>
                <a class="btn-echt hb" href="#">Book</a>
            </nav>
        </div>
        <div class="menu" id="menu">
            <ul class="links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li>
                    <a href="#">Services</a>
                    <ul class="sub">
                        <li><a href="#">Marketing</a></li>
                        <li><a href="#">Strategic Market Development</a></li>
                        <li><a href="#">Legal and Compliance</a></li>
                        <li><a href="#">IT</a></li>
                    </ul>
                </li>
                <li><a href="#">About</a></li>
                <li><a href="#">Team</a></li>
                <li><a href="#">Insights</a></li>
                <li><a href="#">FAQ</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
            <div class="auth">
                <a asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                <a class="btn-echt g" asp-area="Identity" asp-page="/Account/Register">Register</a>
                <a class="btn-echt" href="#">Book</a>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="wrap">
            <div class="fg">
                <div>
                    <b class="fb">ECHT GROUP</b>
                    <p>Where Strategy Meets Opportunity.</p>
                    <a class="btn-echt" href="#">Book a consultation</a>
                </div>
                <div>
                    <h4>Services</h4>
                    <a href="#">Marketing</a>
                    <a href="#">Strategic Market Development</a>
                    <a href="#">Legal and Compliance</a>
                    <a href="#">IT</a>
                </div>
                <div>
                    <h4>Company</h4>
                    <a href="#">About</a>
                    <a href="#">Team</a>
                    <a href="#">Insights</a>
                    <a href="#">FAQ</a>
                    <a href="#">Contact</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
            <div class="cp">&copy; @DateTime.Now.Year ECHT GROUP. All rights reserved.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>