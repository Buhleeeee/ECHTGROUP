@{
    var mainClass = ViewContext.RouteData.Values["area"]?.ToString() == "Identity" ? "wrap idp" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - ECHT GROUP</title>
    <script>
            try {
                if (sessionStorage.getItem('splash')) document.documentElement.classList.add('seen');
                else sessionStorage.setItem('splash', '1');
            } catch (e) { }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="splash" aria-hidden="true">
        <div class="sp-mark">eg.</div>
        <div class="sp-name">ECHT GROUP</div>
    </div>
    <header class="site-header">
        <div class="wrap">
            <nav class="nav" aria-label="Main">
                <div class="hl">
                    <button class="burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu">
                        <i></i><i></i><i></i>
                    </button>
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <span class="mark" aria-hidden="true">eg.</span>ECHT GROUP
                    </a>
                </div>
                <div class="hr">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="icon" asp-area="Identity" asp-page="/Account/Manage/Index" aria-label="Your profile" title="Your profile">
                            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
                        </a>
                    }
                    else
                    {
                        <a class="icon" asp-area="Identity" asp-page="/Account/Login" aria-label="Sign in" title="Sign in">
                            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><path d="M10 17l5-5-5-5" /><path d="M15 12H3" /></svg>
                        </a>
                    }
                    <a class="btn-echt hb" href="#">Book</a>
                </div>
            </nav>
        </div>
        <div class="menu" id="menu">
            <ul class="links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li>
                    <a asp-controller="Services" asp-action="Index">Services</a>
                    <ul class="sub">
                        <li><a asp-controller="Services" asp-action="Details" asp-route-id="marketing">Marketing</a></li>
                        <li><a asp-controller="Services" asp-action="Details" asp-route-id="market-development">Strategic Market Development</a></li>
                        <li><a asp-controller="Services" asp-action="Details" asp-route-id="legal-compliance">Legal and Compliance</a></li>
                        <li><a asp-controller="Services" asp-action="Details" asp-route-id="it">IT</a></li>
                    </ul>
                </li>
                <li><a href="#">About</a></li>
                <li><a href="#">Team</a></li>
                <li><a href="#">Insights</a></li>
                <li><a href="#">FAQ</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
            <div class="auth">
                <a asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                <a class="btn-echt g" asp-area="Identity" asp-page="/Account/Register">Register</a>
                <a class="btn-echt" href="#">Book</a>
            </div>
        </div>
    </header>

    <main role="main" class="@mainClass">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="wrap">
            <div class="fg">
                <div>
                    <b class="fb">ECHT GROUP</b>
                    <p>Where Strategy Meets Opportunity.</p>
                    <a class="btn-echt" href="#">Book a consultation</a>
                </div>
                <div>
                    <h4>Services</h4>
                    <a asp-controller="Services" asp-action="Details" asp-route-id="marketing">Marketing</a>
                    <a asp-controller="Services" asp-action="Details" asp-route-id="market-development">Strategic Market Development</a>
                    <a asp-controller="Services" asp-action="Details" asp-route-id="legal-compliance">Legal and Compliance</a>
                    <a asp-controller="Services" asp-action="Details" asp-route-id="it">IT</a>
                </div>
                <div>
                    <h4>Company</h4>
                    <a href="#">About</a>
                    <a href="#">Team</a>
                    <a href="#">Insights</a>
                    <a href="#">FAQ</a>
                    <a href="#">Contact</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
            <div class="cp">&copy; @DateTime.Now.Year ECHT GROUP. All rights reserved.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>