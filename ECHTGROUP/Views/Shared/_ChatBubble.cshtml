@{
    var isStaff = User.IsInRole("Consultant") || User.IsInRole("Admin");
    var signedIn = User.Identity?.IsAuthenticated == true;
}

@if (!isStaff)
{
    <div class="cb" id="chatBubble"
         data-ask="@Url.Action("Ask", "Assistant")"
         data-handoff="@Url.Action("Handoff", "Assistant")">
        <div class="cb-panel" id="cbPanel" role="dialog" aria-label="ECHT GROUP assistant">
            <div class="cb-head">
                <b>ECHT GROUP assistant</b>
                <button type="button" class="cb-x" id="cbClose" aria-label="Close chat">&times;</button>
            </div>
            <div class="cb-body">
                <div class="cb-log" id="cbLog" aria-live="polite"></div>
                <div class="cb-opts" id="cbOpts"></div>

                <form id="cbHandoff" class="cb-handoff" hidden>
                    @if (!signedIn)
                    {
                        <input name="name" placeholder="Your name" aria-label="Your name" maxlength="100" />
                        <input name="email" type="email" placeholder="Your email" aria-label="Your email" maxlength="200" />
                    }
                    <textarea name="text" rows="3" placeholder="Write your question" aria-label="Your question" maxlength="2000"></textarea>
                    <div class="err" id="cbErr" role="alert"></div>
                    <button class="btn-echt" type="submit">Send to the team</button>
                    <p class="hint cb-note">By sending, you agree to our <a asp-area="" asp-controller="Home" asp-action="Privacy">privacy policy</a>.</p>
                </form>

                <form id="cbAsk" class="cb-ask">
                    <input id="cbText" placeholder="Type your question" aria-label="Type your question" maxlength="300" autocomplete="off" />
                    <button type="submit" class="cb-send" aria-label="Send"><i class="bi bi-send-fill"></i></button>
                </form>

                <p class="hint cb-note">Automated assistant. Detailed questions are passed to our team.</p>
                @Html.AntiForgeryToken()
            </div>
        </div>
        <button type="button" class="cb-btn" id="cbOpen" aria-label="Chat with us" aria-expanded="false" aria-controls="cbPanel"><i class="bi bi-chat-dots-fill"></i></button>
    </div>
}
