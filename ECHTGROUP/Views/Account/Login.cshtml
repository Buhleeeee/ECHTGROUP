@model ECHTGROUP.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="gs">
    <div class="wrap">
        <div class="gs-card auth-card">
            <h2>Sign in</h2>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="err"></div>

                <div class="field">
                    <label>I am signing in as</label>
                    <div class="chips" role="radiogroup" aria-label="Account type">
                        <label><input type="radio" id="type-client" asp-for="AccountType" value="Client" /><span>Client</span></label>
                        <label><input type="radio" id="type-employee" asp-for="AccountType" value="Employee" /><span>ECHT GROUP employee</span></label>
                    </div>
                </div>

                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="pill" autocomplete="email" />
                    <span asp-validation-for="Email" class="err"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="pill" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="err"></span>
                </div>

                <label class="chk">
                    <input asp-for="RememberMe" />
                    <span>Remember me</span>
                </label>

                <div class="gs-go"><button class="btn-echt" type="submit">Sign in</button></div>
            </form>

            <p class="auth-alt">New here? <a asp-action="Register" asp-route-type="@Model.AccountType">Create an account</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}